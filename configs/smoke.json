{
  "model_name": "t5-small",
  "max_seq_length": 80,
  "learning_rate": 0.0003,
  "weight_decay": 0.1,
  "adam_epsilon": 1e-08,
  "warmup_steps": 5,
  "train_batch_size": 8,
  "valid_batch_size": 16,
  "num_train_epochs": 1,
  "max_steps": 100,
  "gradient_accumulation_steps": 1,
  "max_grad_norm": 1.0,
  "seed": 12,
  "nb_sanity_val_steps": 0,
  "train_sample_size": 1,
  "valid_sample_size": 1,
  "max_train_pairs": 800,
  "max_valid_pairs": 16,
  "features_kwargs": {
    "CharRatioFeature": {"target_ratio": 0.8},
    "LevenshteinRatioFeature": {"target_ratio": 0.8},
    "WordRankRatioFeature": {"target_ratio": 0.8},
    "DependencyTreeDepthRatioFeature": {"target_ratio": 0.8}
  },
  "dataset": "wikilarge"
}
